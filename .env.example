# Crow SAP Agent — Configuration Template
# Copy this file to .env and fill in your values

# Solana RPC
SYNAPSE_RPC_URL=https://api.devnet.solana.com
SYNAPSE_API_KEY=your_synapse_api_key_here

# Agent Keypair (path to your Solana keypair JSON)
AGENT_KEYPAIR_PATH=~/.config/solana/id.json

# Ace Data Cloud
ACE_DATA_CLOUD_ENDPOINT=https://platform.acedata.cloud
ACE_DATA_CLOUD_API_KEY=your_ace_data_cloud_api_key_here

# Agent Settings
AGENT_NAME=Crow Market Intelligence
AGENT_DESCRIPTION=Autonomous DeFi market intelligence agent — discovers yield opportunities, analyzes portfolios, executes on-chain actions via SAP with Ace Data Cloud integration
